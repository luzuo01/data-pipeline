# Copy to EnvDreamer/.env; leave key empty for the explicit local parser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Set a model supported by your chosen provider to enable remote planning.
OPENAI_MODEL=
MANISKILL_MODEL=
# Optional separate LeRobot Python executable (absolute path):
# LEROBOT_PYTHON=
# Optional UE Remote Control overrides:
# RC_BASE_URL=http://127.0.0.1:30010
# RC_OBJECT_PATH=
# Optional PORTAL-Trace preview runtime:
# PORTAL_TRACE_ROOT=
# PORTAL_TRACE_PYTHON=
